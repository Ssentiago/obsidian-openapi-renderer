{
    "compilerOptions": {
        "baseUrl": "./src",
        "jsx": "react-jsx",
        "module": "ESNext",
        "target": "ESNext",
        "allowJs": false,
        "strict": true,
        "noImplicitAny": true,
        "moduleResolution": "node",
        "types": ["node"],
        "typeRoots": ["node_modules/@types", "src/typing/interfaces"],
        "importHelpers": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "lib": ["DOM", "ES5", "ES6", "ES7"]
    },
    "include": [
        "**/*.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "obsidian-extensions.d.ts",
        "Globals.d.ts"
    ]
}
