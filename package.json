{
    "name": "openapi-renderer",
    "packageManager": "bun@1.2.23",
    "author": "Sentiago",
    "license": "Apache-2.0",
    "version": "4.5.1",
    "type": "module",
    "description": "Edit and render OpenAPI specifications with Swagger UI, plus standalone offline HTML export.",
    "main": "src/main.ts",
    "scripts": {
        "dev": "NODE_ENV=development rollup -c rollup.config.ts -w",
        "build": "cross-env PRODUCTION=1 NODE_ENV=production rollup -c rollup.config.ts",
        "start": "obsidian-dev-tools start",
        "release": "obsidian-dev-tools release",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [],
    "dependencies": {
        "@apiture/api-ref-resolver": "^1.3.2",
        "@codemirror/autocomplete": "^6.18.7",
        "@codemirror/commands": "^6.9.0",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-yaml": "^6.1.2",
        "@codemirror/language": "^6.11.3",
        "@codemirror/lint": "^6.9.0",
        "@codemirror/search": "^6.5.11",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.38.4",
        "@lezer/common": "^1.2.3",
        "@obsidian-lib/native-react-components": "https://github.com/Ssentiago/native-react-components/releases/download/0.1.0/native-react-components.tgz",
        "@uiw/codemirror-theme-vscode": "^4.25.2",
        "js-yaml": "^4.1.0",
        "preact": "^10.27.2",
        "swagger-ui-dist": "^5.29.2",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "@obsidian-lib/dev-tools": "latest",
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.4",
        "@trivago/prettier-plugin-sort-imports": "^4.3.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.19",
        "@types/react": "^18.3.25",
        "@types/react-dom": "^18.3.7",
        "@types/swagger-ui-dist": "^3.30.6",
        "@types/yazl": "2.4.2",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "@typescript-eslint/utils": "^8.45.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.36.0",
        "obsidian": "^1.10.0",
        "prettier": "^3.6.2",
        "rollup": "^4.52.4",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-import-css": "^3.5.8",
        "rollup-plugin-visualizer": "^5.14.0",
        "tslib": "^2.8.1",
        "typescript": "5.5.4"
    }
